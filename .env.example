# Required: free key from aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here

# Strongly recommended: free Redis from upstash.com (makes daily limits reliable)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional
GEMINI_MODEL=gemini-3.1-flash-lite
PER_IP_DAILY_WORDS=3000
GLOBAL_DAILY_WORDS=60000
